{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted official discovery source registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "organization", "source_type", "priority", "discovery_url", "enabled", "adapter", "notes"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "organization": {"type": "string", "minLength": 2},
      "source_type": {"type": "string", "minLength": 3},
      "priority": {"type": "integer", "minimum": 1},
      "discovery_url": {"type": "string", "format": "uri", "pattern": "^https://"},
      "enabled": {"type": "boolean"},
      "adapter": {"type": "string", "enum": ["manual"]},
      "notes": {"type": "string", "minLength": 10}
    }
  }
}
