{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-evidence-ledger.example/schema/record.schema.json",
  "title": "Open Evidence Ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "event_date", "publication_date", "location", "actors",
    "affected_population", "category", "summary", "claim", "legal_characterization",
    "legal_status", "evidence_type", "source_organization", "source_title", "source_url",
    "source_document_id", "source_page", "source_quote", "verification_notes",
    "related_records", "tags", "created_at", "updated_at"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 10},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "publication_date": {"type": "string", "format": "date"},
    "location": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "actors": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "affected_population": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "category": {"type": "string", "enum": ["legal-proceeding", "detention", "children", "humanitarian-aid", "civilian-infrastructure", "hostages", "attack-on-civilians", "displacement", "statement"]},
    "summary": {"type": "string", "minLength": 30},
    "claim": {"type": "string", "minLength": 20},
    "legal_characterization": {"type": "string", "minLength": 2},
    "legal_status": {"type": "string", "enum": ["ALLEGATION", "DOCUMENTED_EVIDENCE", "UN_FINDING", "COURT_ALLEGATION", "COURT_INTERIM_FINDING", "COURT_FINAL_FINDING", "DISPUTED", "UNKNOWN"]},
    "evidence_type": {"type": "array", "items": {"type": "string", "enum": ["court-order", "arrest-warrant", "official-report", "witness-interview", "document", "image", "video", "medical-record", "satellite-imagery", "expert-analysis"]}, "minItems": 1, "uniqueItems": true},
    "source_organization": {"type": "string", "minLength": 2},
    "source_title": {"type": "string", "minLength": 5},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_document_id": {"type": "string", "minLength": 2},
    "source_page": {"type": ["string", "null"]},
    "source_quote": {"type": ["string", "null"], "maxLength": 500},
    "verification_notes": {"type": "string", "minLength": 20},
    "related_records": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
