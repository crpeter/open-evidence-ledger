{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional candidate claim (not published evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_document_id", "source_organization", "source_title", "source_url", "publication_date", "proposed_event_date", "proposed_category", "proposed_claim", "proposed_legal_status", "supporting_passage", "source_page", "extraction_notes", "related_published_records", "review_status", "review_flags", "created_at", "reviewed_at", "reviewed_by", "review_notes", "proposed_record", "published_record_id"],
  "properties": {
    "id": {"type": "string", "pattern": "^candidate-[a-f0-9]{16}$"},
    "source_document_id": {"type": "string", "minLength": 2},
    "source_organization": {"type": "string", "minLength": 2},
    "source_title": {"type": "string", "minLength": 5},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "publication_date": {"type": "string", "format": "date"},
    "proposed_event_date": {"type": ["string", "null"], "format": "date"},
    "proposed_category": {"type": "string", "enum": ["legal-proceeding", "detention", "children", "humanitarian-aid", "civilian-infrastructure", "hostages", "attack-on-civilians", "displacement", "statement"]},
    "proposed_claim": {"type": "string", "minLength": 20},
    "proposed_legal_status": {"type": "string", "enum": ["ALLEGATION", "DOCUMENTED_EVIDENCE", "UN_FINDING", "COURT_ALLEGATION", "COURT_INTERIM_FINDING", "COURT_FINAL_FINDING", "DISPUTED", "UNKNOWN"]},
    "supporting_passage": {"type": ["string", "null"], "maxLength": 5000},
    "source_page": {"type": ["string", "null"]},
    "extraction_notes": {"type": "string"},
    "related_published_records": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "review_status": {"type": "string", "enum": ["CANDIDATE", "NEEDS_REVIEW", "VERIFIED", "REJECTED", "PUBLISHED"]},
    "review_flags": {"type": "array", "items": {"type": "string", "enum": ["COURT_ALLEGATION_REVIEW", "INTERIM_VS_FINAL_REVIEW", "UN_FINDING_SCOPE_REVIEW", "LATER_PROCEDURAL_POSTURE_REVIEW", "ATTRIBUTION_REVIEW", "PUBLISHED_OVERLAP_REVIEW", "CANDIDATE_DUPLICATE_REVIEW"]}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_by": {"type": ["string", "null"]},
    "review_notes": {"type": ["string", "null"]},
    "proposed_record": {"type": ["object", "null"]},
    "published_record_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  }
}
